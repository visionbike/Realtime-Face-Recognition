<?xml version="1.0" encoding="utf-8" ?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>realtime_face_recognition_ros2</name>
    <version>0.0.1</version>
    <description>
        Real-time face detection, tracking and recognition wrapped as ROS 2 nodes.
        Subscribes to an image stream, publishes an annotated image and JSON recognition results.
    </description>

    <maintainer email="phuc.visionbike@gmail.com">visionbike</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_python</buildtool_depend>

    <!-- runtime deps provided by the sourced ROS install (not pip) -->
    <exec_depend>rclpy</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>vision_msgs</exec_depend>
    <exec_depend>cv_bridge</exec_depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
